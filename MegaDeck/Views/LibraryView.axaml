<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:MegaDeck.Models"
             x:Class="MegaDeck.Views.LibraryView"
             Background="{StaticResource PrimaryColor}">

    <UserControl.Resources>
        <!-- Paneles Grid/List -->
        <ItemsPanelTemplate x:Key="GridViewTemplate">
            <WrapPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListViewTemplate">
            <StackPanel/>
        </ItemsPanelTemplate>

        <!-- DataTemplates de Grid/List -->
        <DataTemplate x:Key="GridItemTemplate" x:DataType="models:GameInfo">
            <Border Classes="game" DoubleTapped="OnGameDoubleTapped">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add cover" Click="OnAssignCoverClick"/>
                        <MenuItem Header="Remove cover" Click="OnRemoveCoverClick" IsEnabled="{Binding HasCover}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Width="150">
                    <Panel Height="200" ClipToBounds="True">
                        <TextBlock Text="No cover" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasCover}"/>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                    </Panel>
                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{StaticResource TextColor}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="5"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListItemTemplate" x:DataType="models:GameInfo">
            <Border Classes="game" DoubleTapped="OnGameDoubleTapped" Height="80">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add cover" Click="OnAssignCoverClick"/>
                        <MenuItem Header="Remove cover" Click="OnRemoveCoverClick" IsEnabled="{Binding HasCover}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <Panel Width="60" Height="60" Margin="5" DockPanel.Dock="Left" ClipToBounds="True">
                        <TextBlock Text="?" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasCover}"/>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                    </Panel>
                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{StaticResource TextColor}"
                               VerticalAlignment="Center" Margin="10,0"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Root Grid -->
    <Grid ColumnDefinitions="150,*">

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarColor}">
            <TextBlock DockPanel.Dock="Top" Text="Library" Foreground="{StaticResource AccentColor}" FontSize="20" FontWeight="Bold"
                       Margin="10" HorizontalAlignment="Center"/>
            <ListBox x:Name="SystemList" Classes="systems" SelectionChanged="OnSystemSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:GameSystem">
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Contenido principal -->
        <DockPanel Grid.Column="1">
            <!-- Barra superior con buscador y toggle -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" Spacing="10">
                <TextBox x:Name="SearchBox" Width="200" Watermark="Search..." TextChanged="SearchBox_TextChanged"/>
                <ToggleButton x:Name="ViewToggleButton" Content="Grid / List" IsCheckedChanged="ViewToggleButton_Changed"/>
            </StackPanel>

            <!-- Mensajes de error -->
            <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Background="#5A1E2A" CornerRadius="5" Margin="10,0,10,5"
                    Padding="10,6" IsVisible="False">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Background="Transparent" Padding="6,0" Click="OnCloseError"/>
                    <TextBlock x:Name="ErrorText" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Lista de juegos -->
            <ScrollViewer>
                <ItemsControl x:Name="RomList" Margin="10"
                              ItemsPanel="{StaticResource GridViewTemplate}"
                              ItemTemplate="{StaticResource GridItemTemplate}"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Overlay de carga -->
        <Grid x:Name="LoadingOverlay" Grid.ColumnSpan="2" Background="#88000000" IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                <TextBlock Text="Launching game..." Foreground="White" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
