<ClassicWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="MegaDeck.Views.ExtractDialog"
               Title="Extracting..."
               Icon="/megadeck.ico"
               SizeToContent="WidthAndHeight"
               WindowStartupLocation="CenterOwner"
               CanResize="False"
               ShowInTaskbar="False">

    <StackPanel Margin="12,10" Width="360" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
            <Image Source="/Assets/cd32.png" Width="32" Height="32" RenderOptions.BitmapInterpolationMode="None"/>
            <TextBlock Text="» » »" VerticalAlignment="Center" FontWeight="Bold"/>
            <Image Source="/Assets/cd32.png" Width="32" Height="32" RenderOptions.BitmapInterpolationMode="None"/>
        </StackPanel>

        <TextBlock x:Name="FileText" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="To the MegaDeck cache folder"/>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="18" Margin="0,4"/>
        <TextBlock x:Name="SizeText"/>

        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" MinWidth="75" Margin="0,6,0,0" Click="OnCancelClick"/>
    </StackPanel>
</ClassicWindow>
