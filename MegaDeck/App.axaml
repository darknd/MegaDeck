<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
             x:Class="MegaDeck.App"
             RequestedThemeVariant="{x:Static ClassicTheme.Classic}">

    <!-- Tamaños de letra mayores que los del tema (11 px): Tahoma sin suavizado
         se deforma a ese tamaño en pantallas actuales. -->
    <Application.Resources>
        <x:Double x:Key="FontSizeSmall">11</x:Double>
        <x:Double x:Key="FontSizeNormal">13</x:Double>
        <x:Double x:Key="FontSizeLarge">15</x:Double>
        <x:Double x:Key="{x:Static common:NonClientMetrics.CaptionFontSizeKey}">13</x:Double>
        <x:Double x:Key="{x:Static common:SystemParameters.WindowCaptionHeightKey}">22</x:Double>
        <x:Double x:Key="{x:Static common:SystemParameters.MenuBarHeightKey}">22</x:Double>
    </Application.Resources>

    <Application.Styles>
        <!-- Tema Windows 9x (variante "Classic": gris plata y títulos azul marino de Windows 95) -->
        <ClassicTheme FontAliasing="False"/>

        <!-- Vista "Iconos grandes": como el Explorador, solo se resalta la etiqueta del elemento -->
        <Style Selector="ListBox.icons ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.WindowTextBrushKey}}"/>
        </Style>
        <Style Selector="ListBox.icons ListBoxItem:selected /template/ Border#Bd">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.icons ListBoxItem TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.WindowTextBrushKey}}"/>
        </Style>
        <Style Selector="ListBox.icons ListBoxItem:selected TextBlock.label">
            <Setter Property="Background" Value="{DynamicResource {x:Static common:SystemColors.HighlightBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.HighlightTextBrushKey}}"/>
        </Style>
        <Style Selector="ListBox.icons ListBoxItem Border.tint">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static common:SystemColors.HighlightBrushKey}}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="ListBox.icons ListBoxItem:selected Border.tint">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Cabeceras de columna de la vista "Detalles" -->
        <Style Selector="Button.column">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Application.Styles>
</Application>
